# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# =============================================================================
# MODE CONFIGURATION
# =============================================================================
# Set to "production" when deploying with Docker, or "development" for local dev
SUPAPANEL_MODE="development"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL is required (both development and production)
# 
# For local development, use docker-compose.dev.yml to run PostgreSQL:
#   docker compose -f docker-compose.dev.yml up -d
#   Then use this connection string:
DATABASE_URL="postgresql://supapanel:supapanel_dev_password@localhost:5433/supapanel"

# For production (set by install.sh):
# DATABASE_URL="postgresql://supapanel:your_password@postgres:5432/supapanel"

# =============================================================================
# AUTHENTICATION
# =============================================================================
NEXTAUTH_SECRET="your-secret-key-here-make-this-random-and-secure"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# SMTP CONFIGURATION (Optional)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
SUPABASE_CORE_REPO_URL="https://github.com/supabase/supabase"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
APP_NAME="Supabase Console Dashboard"
APP_URL="http://localhost:3000"

# =============================================================================
# TRAEFIK CONFIGURATION (Production only)
# =============================================================================
# Email for Let's Encrypt SSL certificates
TRAEFIK_ACME_EMAIL="admin@example.com"

# =============================================================================
# DATA PATHS (Production only - set by install.sh)
# =============================================================================
# DATA_PATH="/etc/supapanel"
# Docker Compose / Dokploy (see docs/DOKPLOY.md)
# PROXY_MODE="dokploy"
# PROXY_NETWORK="dokploy-network"
# PROXY_ENTRYPOINT="websecure"
# PROXY_CERT_RESOLVER="letsencrypt"
# POSTGRES_PASSWORD="generate-a-random-alphanumeric-password"
# SUPABASE_CORE_REF must be a verified upstream Git commit or tag.
SUPABASE_CORE_REF="9e225a279b33e4e6e1452e573a40a6a25aa2cb2f"

# Optional central hostname used as the CNAME target for API/Studio domains
# INSTANCE_DNS_TARGET="infra.example.com"
